# Copy to .env and adjust as needed. Compose has sane defaults baked in,
# so .env is optional for local development.

# Django
# DEBUG defaults to False. For local dev, set DJANGO_DEBUG=1 — that flips on
# the dev SECRET_KEY fallback, opens CORS, and seeds ALLOWED_HOSTS for you.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is unset/0. Leave blank in dev to use the
# (insecure) dev fallback.
DJANGO_SECRET_KEY=
# Comma-separated hostnames. Required when DEBUG is off.
DJANGO_ALLOWED_HOSTS=

# Postgres
POSTGRES_DB=qpg
POSTGRES_USER=qpg
POSTGRES_PASSWORD=qpg
POSTGRES_HOST=db
POSTGRES_PORT=5432

# LLM — Gemini, used by bank ingestion (native-PDF extraction, ADR-0004).
# Get a key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# gemini-3.5-flash (newest gen, near-pro accuracy, fast/cheap) is the default.
# For max accuracy on the one-time batch use gemini-3.1-pro-preview, or
# gemini-3.5-pro once it is GA.
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60

# Experimental OCR extraction for uploaded previous-year papers. Keep default
# native-PDF Gemini unless you explicitly run/test the OCR batch drainer.
# EXTRACTION_PIPELINE=mistral-ocr-batch
# OCR_BATCH_PAGES=999
# MISTRAL_OCR_API=

# Bulk Q&A generation can use a cheaper OpenAI-compatible route without changing
# the ingestion model. Example OpenRouter setup:
# LLM_QUESTION_GENERATION_PROVIDER=openrouter
# LLM_QUESTION_GENERATION_MODEL=google/gemini-3.5-flash
# OPENROUTER_API_KEY=
#
# DeepSeek also works through the same seam:
# LLM_QUESTION_GENERATION_PROVIDER=deepseek
# LLM_QUESTION_GENERATION_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=

# How often the generation-worker drains queued Q&A batches.
GENERATION_DRAIN_INTERVAL_SECONDS=10

# --- Function-specific AI configuration ---
# 1) OCR for uploaded PDFs: Mistral turns PDF pages into markdown.
# Use this pipeline when you want OCR-first ingestion instead of native-PDF Gemini.
EXTRACTION_PIPELINE=mistral-ocr-batch
OCR_BATCH_PAGES=999
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# 2) Extraction structuring LLM: Gemini model via OpenRouter turns OCR markdown
# into Question JSON. Uses OPENROUTER_API_KEY below.
LLM_EXTRACTION_PROVIDER=openrouter
LLM_EXTRACTION_MODEL=google/gemini-3.5-flash

# 3) Bulk Q&A generation LLM: separate purpose, same OpenRouter key/model by default.
LLM_QUESTION_GENERATION_PROVIDER=openrouter
LLM_QUESTION_GENERATION_MODEL=google/gemini-3.5-flash

# 4) Optional upload-answer generation LLM: same OpenRouter key/model.
LLM_ANSWER_GENERATION_PROVIDER=openrouter
LLM_ANSWER_GENERATION_MODEL=google/gemini-3.5-flash

# Shared OpenRouter key for functions 2, 3, and 4.
OPENROUTER_API_KEY=
# --- End function-specific AI configuration ---
